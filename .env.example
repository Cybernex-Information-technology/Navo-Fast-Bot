# ==============================================================================
# Navo Fast Bot — Konfiguratsiya va Muhit Sozlamalari (.env)
# ==============================================================================
# Ushbu faylni `.env` nomiga nusxalang (masalan: copy .env.example .env)
# va qiymatlarni o'z serveringizga mos ravishda to'ldiring.

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT ASOSIY SOZLAMALARI
# ------------------------------------------------------------------------------
# @BotFather dan olingan bot tokeni (Majburiy)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz

# Bot foydalanuvchi nomi (@ bilan yoki @ siz)
BOT_USERNAME=@navofast_bot

# Loyiha / Jamoa nomi
TEAM_NAME=CyberNexTeam

# ------------------------------------------------------------------------------
# 2. ADMIN VA NAZORAT (ADMIN PANEL & STATISTIKA)
# ------------------------------------------------------------------------------
# Bot adminlarining Telegram ID raqamlari. Vergul bilan ajrating.
# Adminlar /admin, /stat va /broadcast buyruqlaridan foydalana oladilar.
# O'z ID raqamingizni bilish uchun Telegramda @userinfobot ga yozing.
ADMIN_IDS=12345678,87654321

# ------------------------------------------------------------------------------
# 3. REKLAMA VA IJTIMOIY TARMOQLAR
# ------------------------------------------------------------------------------
# Video ostida chiqadigan Instagram havolasi (bo'sh qoldirilsa ko'rinmaydi)
INSTAGRAM_URL=https://instagram.com/cybernexteam

# Video ostida chiqadigan rasmiy Telegram kanal havolasi
CHANNEL_URL=https://t.me/cybernexteam

# ------------------------------------------------------------------------------
# 4. MA'LUMOTLAR BAZASI VA KESH (DATABASE)
# ------------------------------------------------------------------------------
# PostgreSQL ulanish manzili (Majburiy)
# Format: postgresql://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA_NOMI
# Bot va PostgreSQL bitta serverda, bot esa Docker ichida bo'lsa, host sifatida
# localhost emas, host.docker.internal yoki serverning IP manzilini yozing.
DATABASE_URL=postgresql://navo:parol@localhost:5432/navo_bot

# Ulanishlar pool'i hajmi (ixtiyoriy)
DB_POOL_MIN=1
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 5. SERVER BLOKLANISHLARIDAN HIMOYA (PROKSI VA COOKIES)
# ------------------------------------------------------------------------------
# VPS yoki Data-center IP lari YouTube yoki Instagram tomonidan bloklansa (429 xatosi),
# shu yerga HTTP yoki SOCKS5 proksi yozing.
# Masalan: http://user:pass@1.2.3.4:8080 yoki socks5://127.0.0.1:9050
YTDLP_PROXY=

# Brauzerdan eksport qilingan YouTube / Instagram cookie fayli manzili
# Masalan: cookies.txt (Serverda YouTube 'Sign in' xatosining 100% yechimi)
COOKIES_FILE=

# ------------------------------------------------------------------------------
# 6. UNUMLORLIK VA CHEKLOVLAR (PERFORMANCE)
# ------------------------------------------------------------------------------
# Bir vaqtning o'zida nechta yuklash jarayoni parallel ishlashi mumkinligi (Default: 4)
CONCURRENCY_LIMIT=4
